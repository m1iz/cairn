# Environment / local config
.env
.env.*
!.env.example
model_config.json
mcp_config.json
cairn.local.json
/templates/USER.local.md
/templates/*.local.md

# Python caches kept only for legacy tooling/skill helpers, not product runtime
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS / editor noise
.DS_Store
.idea/
.vscode/
.history/
*.swp
*.swo
*~

# JavaScript / TypeScript dependencies and build caches
node_modules/
.tools/
native/windows-sandbox/target/
/.sandbox-debug/
desktop/node_modules/
packages/*/dist/
packages/*/coverage/
coverage/
.vite/
.cache/
.eslintcache
*.tsbuildinfo

# Build and test outputs
/build/
/desktop/out/
/desktop/dist/
/desktop/build/backend/
/desktop/build/cairn-windows-sandbox.exe
/desktop/build/runtime-defaults-manifest.json*
/desktop/screenshots/
/desktop/test-results/
/desktop/.uiplan-progress.json

# Local SWE-bench evaluation harness (never part of the product)
/pnpm-lock.yaml
/packages/core/pnpm-lock.yaml
/packages/core/pnpm-workspace.yaml
/packages/core/src/agent/swe-sample-eval.live.test.ts

# Local memory evaluation harnesses and datasets (never publish)
/packages/core/src/memory/fixtures/hybrid-memory-eval-v2.json
/packages/core/src/memory/hybrid-eval.ts
/packages/core/src/memory/hybrid-eval.test.ts
/packages/core/src/memory/hybrid-offline-eval.test.ts
/packages/core/src/memory/hybrid-real-eval.integration.test.ts
/packages/core/src/memory/longmemeval-eval.ts
/packages/core/src/memory/longmemeval-eval.test.ts
/packages/core/src/memory/longmemeval-retrieval.integration.test.ts
/packages/core/src/memory/longmemeval-global.integration.test.ts

# Logs / local automation state
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
/.claude/
/.superpowers/

# Personal development documents (local-only; never publish)
/private-docs/
/docs/private/
/docs/archive/
/docs/superpowers/
/docs/audit/
/docs/diagnostics/
/docs/research/
/docs/roadmap/
/docs/qa/
/docs/plans/
/docs/specs/
/docs/design/
/docs/tasks/
/docs/migration/
