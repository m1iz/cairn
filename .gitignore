# 运行期产生的私人数据（长期记忆 / 会话历史 / token 用量）
# 规则必须锚定在仓库根目录，避免误忽略 packages/core/src/memory 等源码目录。
/memory/
/sessions/
/desktop/memory/
/desktop/sessions/
.cairn/
/packages/*/memory/
/packages/*/sessions/

# Versioned, secret-free compatibility fixtures intentionally mirror runtime
# filenames that are ignored everywhere else.
!/packages/core/fixtures/python-runtime/model_config.json
!/packages/core/fixtures/python-runtime/mcp_config.json

# Agent Team 运行期状态（队友配置 / inbox / 独立 thread）
.team/
/packages/*/.team/
!/packages/core/fixtures/python-runtime/.team/
!/packages/core/fixtures/python-runtime/.team/**
